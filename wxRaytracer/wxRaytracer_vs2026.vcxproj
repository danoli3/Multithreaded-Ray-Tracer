    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>WIN32;_DEBUG;_WINDOWS;__WXMSW__;WXUSINGDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(WXWIN)\include;$(WXWIN)\include\msvc;raytracer\BRDFs;raytracer\build;raytracer\Cameras;raytracer\GeometricObjects;raytracer\Lights;raytracer\Materials;raytracer\Samplers;raytracer\Tracers;raytracer\UserInterface;raytracer\Utilities;raytracer\World;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <LanguageStandard>stdcp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Prefer wx built with the v145 toolset; fall back to a v143 wx build
         (wx releases predating VS2026 name their lib dir vc143 even when
         compiled with VS2026). -->
      <AdditionalLibraryDirectories Condition="Exists('$(WXWIN)\lib\vc145_dll')">$(WXWIN)\lib\vc145_dll;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="!Exists('$(WXWIN)\lib\vc145_dll') and Exists('$(WXWIN)\lib\vc143_dll')">$(WXWIN)\lib\vc143_dll;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
