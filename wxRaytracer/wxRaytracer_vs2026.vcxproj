  <!-- Requires wxWidgets 3.2.x built for v145 (see lib-dir fallback below). Set the WXWIN environment
       variable to your wx root, e.g. C:\wxWidgets-3.2.5 -->
  <PropertyGroup>
    <OutDir>bin\vs2026\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>obj\vs2026\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- WIN32 is defined for the Win32 platform only; the compiler predefines
       _WIN32 (both platforms) and _WIN64 (x64). SDL checks stay off: this is
       a legacy codebase and /sdl elevates warnings this code still trips. -->
